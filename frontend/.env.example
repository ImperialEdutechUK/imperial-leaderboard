# ─────────────────────────────────────────────────────────────
#  Imperial Leaderboard — Frontend environment variables
#  Copy to .env.local for local dev. On Vercel, set as Environment Variables.
# ─────────────────────────────────────────────────────────────

# Base URL of the backend API (no trailing slash).
# Local:      http://localhost:4000
# Production: https://your-api.up.railway.app
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Shown in the site header. Change to your company name.
NEXT_PUBLIC_SITE_NAME="Imperial Learning"
