# ─────────────────────────────────────────────────────────────
#  Imperial Leaderboard — Backend environment variables
#  Copy to .env for local dev. On Railway, set these as Variables.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Railway: add a PostgreSQL plugin, then reference it as ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leaderboard?schema=public"

# Port the API listens on. Railway injects PORT automatically — do not hardcode there.
PORT=4000

# Secret used to sign manager JWTs.
# MUST be changed before going live. Generate with:  openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string-before-deploying"

# How long a manager session lasts.
JWT_EXPIRES_IN="8h"

# Comma-separated list of origins allowed to call this API.
# Include your Vercel production domain AND any preview domains you use.
CORS_ORIGINS="http://localhost:3000,https://your-frontend.vercel.app"

# Public site URL (used in generated share links).
PUBLIC_SITE_URL="http://localhost:3000"

# Bootstrap admin — created by `npm run seed` if no ADMIN user exists yet.
# Change the password immediately after first login.
SEED_ADMIN_EMAIL="sadeev@imperiallearning.co.uk"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
SEED_ADMIN_NAME="Sadeev Silva"

# Set to "true" to also seed the real 6-12 Apr 2026 Course Development week
# from the sample report, so the app is not empty on first run.
SEED_SAMPLE_WEEK="true"

# Max upload size in megabytes.
MAX_UPLOAD_MB=15

# Node environment
NODE_ENV="development"
